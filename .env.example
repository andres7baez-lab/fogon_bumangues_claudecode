# =====================================================================
#  Variables de entorno de El Fogón Bumangués
#  Copie este archivo como .env (en su computador) y llene los valores.
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# =====================================================================

# URL de Neon CON pooler (el servidor contiene "-pooler"). La usa la aplicación.
# En Neon: Connect → marque "Connection pooling" → copie la cadena.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# URL de Neon SIN pooler (directa). La usan manage.py init-db y seed.py.
# En Neon: Connect → desmarque "Connection pooling" → copie la cadena.
# Si se deja vacía, se usa DATABASE_URL quitando "-pooler" del servidor.
DIRECT_URL=postgresql://USUARIO:CONTRASENA@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Clave que firma la sesión del navegador. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use una distinta en su computador y en Vercel.
SECRET_KEY=

# Solo para las pruebas automáticas: base de la rama "desarrollo" de Neon.
# NUNCA ponga aquí la base de producción (rama main). Las pruebas trabajan
# en un esquema aparte llamado "pruebas" que se borra en cada prueba.
TEST_DATABASE_URL=
